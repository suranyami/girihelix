# ---------------------------------------------------------------------------
# Reference implementations -- LOCAL ONLY, never published
# ---------------------------------------------------------------------------
# Both Taprats versions are kept locally as porting oracles and are excluded
# from this repository:
#
#   reference/0.3/      Taprats 0.3 (2000). All rights reserved -- "You may not
#                       copy, redistribute or reuse this source code".
#   reference/1.1.12/   Taprats 1.1.12, the maintained release. It is GPL, so it
#                       could be redistributed, but it is deliberately kept out
#                       of the published tree as well, to keep third-party
#                       source out of the repository.
#
# girihelix itself is GPLv3-or-later (see LICENSE). The decision to derive from
# Taprats, and the licence reasoning behind it, are recorded in
# docs/algorithm-analysis.md.
/reference/

# ---------------------------------------------------------------------------
# Elixir / Phoenix
# ---------------------------------------------------------------------------
# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

*.beam

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
girihelix-*.tar

# ---------------------------------------------------------------------------
# Assets
# ---------------------------------------------------------------------------
# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.DS_Store
.elixir_ls/

.aide/memories/preferences/personal/
.aide/cache/
.aide/recall-log.jsonl
.aide/pending-memories.jsonl
.cursor/rules/aide-memory.mdc
